{
  "name": "reaktionszeit-app",
  "version": "0.1.0",
  "private": true,
  "description": "Lokale Windows-App zur Erfassung einfacher Reaktionszeit-Durchgänge.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env APP_ENV=development electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.7",
    "cross-env": "10.1.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "vite": "8.3.5",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "de.collegeprojekt.reaktionszeit",
    "productName": "Reaktionszeit-App",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
